<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Glosslay.Core — UI に依存しない中核ロジック
      Capture / Preprocess / IOcrEngine / ITranslator / Overlay の Win32 相互運用など

    TargetFramework 等は Directory.Build.props で一元管理している。上書きしないこと。
    WinRT（Windows.Graphics.Capture / Windows.Media.Ocr / Windows.Gaming.Input）を
    使うため、TargetFramework は Windows 版のまま据え置く。
  -->

  <PropertyGroup>
    <!-- 名前空間は Glosslay 起点（AGENTS.md 命名規約）。
         例: Capture/ 配下は Glosslay.Capture になる。 -->
    <RootNamespace>Glosslay</RootNamespace>

    <!-- CsWin32 が生成する COM 相互運用コードがポインタを使うため必須。
         Directory.Build.props では定義していないプロジェクト固有の設定。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Microsoft.Windows.CsWin32 — Win32 / COM の P/Invoke をビルド時に C# 生成する
      ソースジェネレータ。生成対象は NativeMethods.txt に列挙したものだけ。

      PrivateAssets=all のため実行時 DLL を一切同梱しない。
      配布サイズ・AV 誤検知への影響はゼロ（RULES.md 🔵「依存関係を増やすときは相談する」に基づき
      2026-09-08 に人間の承認を得て追加）。
    -->
    <!--
      ONNX Runtime — PaddleOCR（PP-OCRv6）とローカルNMTで共有する推論基盤。
      AGENTS.md の技術スタックで確定済み。GPU 版ではなく CPU 版を使う
      （RULES.md「GPU推論は既定で無効」。ゲームと VRAM を奪い合わない）。
    -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <!--
      Microsoft.ML.Tokenizers — ローカルNMT（Marian）の SentencePiece 分割。
      Marian の .spm は Unigram 方式で、自前実装すると学習時の分割とずれて
      訳文が静かに劣化する（実行時エラーにならないため発見が遅れる）。

      マネージド実装でネイティブ DLL を持たない（RULES.md 🔴-2 の AV 誤検知に有利）。
      本体 318KB + 推移的な Google.Protobuf 478KB = 約 800KB。モデル 146MB に対して誤差。
      RULES.md 🔵「依存関係を増やすときは相談する」に基づき 2026-10-01 に人間の承認を得て追加。
    -->
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.333">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    画面の文言の訳（FR-SYS-03）。「日本語の文 → 訳」の JSON を言語ごとに持つ（UiText）。
    実行ファイルに埋め込むのは、置き忘れで画面が日本語に戻る事故を避けるため。
    名前は Glosslay.Localization.<言語>.json に固定する（UiText.TableFor が引く）。
  -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="Glosslay.Localization.%(Filename).json" />
  </ItemGroup>

</Project>
