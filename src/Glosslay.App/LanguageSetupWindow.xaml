<Window x:Class="Glosslay.LanguageSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glosslay"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <!--
        初回起動時にメイン言語（画面と訳文の言語）を選ぶ（FR-SYS-03 / FR-SYS-05）。
        どの言語の人でも読めるよう、説明は 4 言語で併記し、ボタンはその言語自身の表記で書く。
        TextBlock ごとに Language を付けるのは、漢字を簡体字・日本語それぞれの字形で出すため。
        インストーラ版では、インストーラが選んだ言語を書いておけばこの画面は出ない。
    -->

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20" MinWidth="360">
        <TextBlock Text="言語を選んでください" FontSize="15" Language="ja" />
        <TextBlock Text="Choose your language" FontSize="15" Margin="0,2,0,0" Language="en" />
        <TextBlock Text="请选择语言" FontSize="15" Margin="0,2,0,0" Language="zh-Hans" />
        <TextBlock Text="언어를 선택하세요" FontSize="15" Margin="0,2,0,0" Language="ko" />

        <StackPanel Margin="0,16,0,0">
            <Button Tag="ja" Content="日本語" Language="ja" Click="OnLanguageClick" />
            <Button Tag="en" Content="English" Language="en" Click="OnLanguageClick" />
            <Button Tag="zh-Hans" Content="简体中文" Language="zh-Hans" Click="OnLanguageClick" />
            <Button Tag="ko" Content="한국어" Language="ko" Click="OnLanguageClick" />
        </StackPanel>

        <TextBlock Margin="0,14,0,0" Foreground="#666" FontSize="11" TextWrapping="Wrap" MaxWidth="360">
            <Run Text="あとから設定で変えられます。" Language="ja" />
            <LineBreak />
            <Run Text="You can change this later in Settings." Language="en" />
            <LineBreak />
            <Run Text="之后可以在设置中更改。" Language="zh-Hans" />
            <LineBreak />
            <Run Text="나중에 설정에서 변경할 수 있습니다." Language="ko" />
        </TextBlock>
    </StackPanel>

</Window>
