<Window x:Class="Glosslay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glosslay Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        IsHitTestVisible="False">

    <!--
        訳文を重ねる透過ウィンドウ（FR-OVL-01）。

        必須の拡張スタイルは OverlayWindowStyles がコード側で設定する。
        XAML でできるのは AllowsTransparency（WS_EX_LAYERED）と Topmost まで。
        クリックスルー・非アクティブ化・Alt+Tab 非表示は SetWindowLongPtr が必要。
    -->

    <Canvas x:Name="LayerCanvas" />
</Window>
