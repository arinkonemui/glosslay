<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Glosslay.App — WPF デスクトップアプリ本体（配布される exe）

    TargetFramework / Nullable / ImplicitUsings / 警告設定などは
    ルートの Directory.Build.props で一元管理している。ここで上書きしないこと。
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>

    <!-- 名前空間・アセンブリ名は Glosslay（AGENTS.md 命名規約）。
         出力は Glosslay.exe になる。 -->
    <RootNamespace>Glosslay</RootNamespace>
    <AssemblyName>Glosslay</AssemblyName>

    <!-- 管理者権限を要求しない / 高DPIで座標がずれない（RULES.md 🟠 / FR-CAP-09） -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Glosslay.Core\Glosslay.Core.csproj" />
  </ItemGroup>

  <!--
    開発時の利便のため、tools/ocr-eval/models に取得した OCR モデルを出力先へ複製する。
    モデルは .gitignore で除外しているため、無い環境ではこのブロックごと無効になる
    （その場合 PaddleOcrEngine が「モデルが見つかりません」と具体的に知らせる）。
    配布時はインストーラで models/ を同梱する。
  -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\ocr-eval\models')">
    <None Include="..\..\tools\ocr-eval\models\**\*.onnx;..\..\tools\ocr-eval\models\*.txt">
      <Link>models\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <!--
    同じく、tools/nmt-convert で変換したローカルNMT のモデルを models\nmt\en-ja へ複製する。
    LocalNmtOptions.ModelDirectory の既定と一致させてある。

    .spm は patch_spm.py で bos_id を書き換えたものでなければ読み込みで落ちる
    （tools/nmt-convert/README.md）。convert.py が書き換えたものを出す。
  -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\nmt-convert\out\elan-en-ja\int8')">
    <None Include="..\..\tools\nmt-convert\out\elan-en-ja\int8\*.onnx;..\..\tools\nmt-convert\out\elan-en-ja\int8\*.spm;..\..\tools\nmt-convert\out\elan-en-ja\int8\vocab.json">
      <Link>models\nmt\en-ja\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <!--
    中→英のモデル（2026-10-19 追加）を models\nmt\zh-en へ複製する。LocalNmtOptions.ChineseModelDirectory の既定と一致させてある。
    中国語の原文を訳すのに使う（訳先が英語なら中→英、日本語なら中→英→日）。無くても他の翻訳は動く。
    変換は tools/nmt-convert（convert.py Helsinki-NLP/opus-mt-zh-en out/opus-zh-en）。
  -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\nmt-convert\out\opus-zh-en\int8')">
    <None Include="..\..\tools\nmt-convert\out\opus-zh-en\int8\*.onnx;..\..\tools\nmt-convert\out\opus-zh-en\int8\*.spm;..\..\tools\nmt-convert\out\opus-zh-en\int8\vocab.json">
      <Link>models\nmt\zh-en\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
